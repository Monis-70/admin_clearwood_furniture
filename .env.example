# Public build-time settings. NEXT_PUBLIC_* values are inlined into the static bundle: never put a
# secret here.

# API base. Same-origin by default (nginx proxies /api to the Express API). Only set an absolute
# URL for the cross-origin deployment option (docs/ADMIN_DEPLOYMENT_PLAN.md, option B).
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Label shown in the top bar; anything other than "production" shows a coloured environment badge.
NEXT_PUBLIC_APP_ENV=development

# Storefront origin for "View on storefront" links (UNKNOWN in production; leave empty to hide).
NEXT_PUBLIC_STOREFRONT_URL=

# next dev only: where the /api rewrite proxies to.
CLEARWOOD_API_ORIGIN=http://localhost:7180

# contracts:sync / contracts:check --against-backend: path of the backend checkout.
CLEARWOOD_BACKEND_DIR=../clearwood-backend-repo
