# TLS for the admin host (Mozilla "intermediate"). Rendered to
# /etc/nginx/snippets/clearwood-admin-tls.conf by deploy/scripts/render-nginx.sh.
ssl_certificate     /etc/letsencrypt/live/__ADMIN_HOST__/fullchain.pem;
ssl_certificate_key /etc/letsencrypt/live/__ADMIN_HOST__/privkey.pem;
ssl_protocols TLSv1.2 TLSv1.3;
ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
ssl_prefer_server_ciphers off;
ssl_session_cache shared:clearwood_admin_tls:10m;
ssl_session_timeout 1d;
ssl_session_tickets off;
