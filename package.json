{
  "name": "clearwood-admin",
  "version": "0.1.0",
  "private": true,
  "description": "ClearWood Furnitures admin dashboard (static Next.js export against the ClearWood API)",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev -p 7182",
    "prebuild": "npm run contracts:check && npm run coverage:check",
    "build": "next build",
    "preview": "node scripts/serve-static.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "pree2e": "next build",
    "e2e": "playwright test",
    "e2e:real": "playwright test -c playwright.real.config.ts",
    "contracts:sync": "node scripts/contracts/sync.mjs",
    "contracts:check": "node scripts/contracts/check.mjs",
    "coverage:check": "tsx scripts/check-coverage.ts",
    "coverage:doc": "tsx scripts/coverage-doc.ts",
    "bundle:report": "node scripts/bundle-report.mjs",
    "verify": "npm run contracts:check && npm run coverage:check && npm run coverage:doc -- --check && npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build && npm run bundle:report"
  },
  "dependencies": {
    "@floating-ui/react-dom": "2.1.9",
    "@fontsource-variable/inter": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-query": "5.103.2",
    "@tanstack/react-table": "9.2.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.13.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "jsdom": "30.1.1",
    "msw": "2.15.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
